# ==============================================================================
# 玩可爱智能客服 Agent · 后端环境变量模板
# ------------------------------------------------------------------------------
# 用法：复制为 .env 后按环境填写。**不要提交 .env 到仓库**（已在 .gitignore）。
# 所有变量前缀 WK_，与 app/core/config.py 的 Settings.env_prefix 一致。
#
# 合规硬约束（违反即验收不通过）：
#   HC-1 不生成/不发送任何外链、跳转卡片、小程序唤起
#   HC-2 数据不出境、不用于模型训练、最小必要、可删除可追溯
#   HC-3 会变的数字（库存/价格/物流单号）永远走接口；库存价格字段不得进向量库
#
# 密钥类字段（WK_INTERNAL_TOKEN / WK_APP_SECRET / WK_LLM_API_KEY 等）：
#   生产必须由 KMS 或密钥管理服务注入，**禁止硬编码、禁止提交仓库**。
# ==============================================================================

# ------------------------------------------------------------------------------
# 基础信息
# ------------------------------------------------------------------------------
# local | dev | test | prod
# local  : 全部使用本地等价适配器（无需 PG/Milvus/ES/Redis），单进程可跑
# dev/test: 依赖真实中间件，QPS 按生产 1/5 折算
# prod   : 生产，密钥必须来自 KMS
WK_ENV=local
WK_DEBUG=false
# 对外固定域名（回调 URL 必须 HTTPS + 已备案，契约 2.3.4）
WK_PUBLIC_BASE_URL=https://agent.wankeai.example.com

# ------------------------------------------------------------------------------
# 商家渠道契约（契约 A / 接口对接说明书 v1.0）
# ------------------------------------------------------------------------------
# 生产 https://open.wankeai.example.com
# 测试 https://open-test.wankeai.example.com（VPN 内网，数据每日 03:00 重置）
# 沙箱 https://open-sandbox.wankeai.example.com
WK_MERCHANT_BASE_URL=https://open-test.wankeai.example.com
WK_APP_ID=dsh_agent_001
# 应用级 Token，由商家分配
WK_INTERNAL_TOKEN=
# HMAC-SHA256 签名密钥：sign_str = app_id + timestamp + nonce + body_sha256
WK_APP_SECRET=
WK_TIMESTAMP_SKEW_SECONDS=300
WK_NONCE_TTL_SECONDS=300
# 生产必须 true；本地自测回调可用 false 跳过签名校验
WK_VERIFY_CALLBACK_SIGNATURE=true
WK_MERCHANT_TIMEOUT_SECONDS=5.0
WK_MERCHANT_CONNECT_TIMEOUT_SECONDS=2.0
# 测试环境 QPS 为生产 1/5
WK_IS_MERCHANT_TEST_ENV=true

# ------------------------------------------------------------------------------
# 数据源 · 关系库
# ------------------------------------------------------------------------------
# 生产（任务书 3.1 锁定）：PostgreSQL 14
WK_POSTGRES_DSN=postgresql+psycopg2://wkagent:wkagent@postgres:5432/wkagent
WK_POSTGRES_POOL_SIZE=10
WK_POSTGRES_MAX_OVERFLOW=20
WK_POSTGRES_ECHO=false
# 本地无 PostgreSQL 时的等价实现：SQLite（同一套 SQLAlchemy 模型）
# WK_LOCAL_DB_PATH=D:/learn/homework/agent/backend/.local/wkagent.db

# ------------------------------------------------------------------------------
# 数据源 · Redis 7（会话状态 / Nonce 去重 / 幂等键 / 限流计数 / 工单队列）
# ------------------------------------------------------------------------------
WK_REDIS_URL=redis://redis:6379/0
WK_REDIS_SOCKET_TIMEOUT=2.0
# 会话状态 TTL 30 分钟。**Redis 只存脱敏状态**，不含完整手机号/地址/身份证
WK_SESSION_TTL_SECONDS=1800
# msg_id 幂等去重 TTL 24 小时
WK_IDEMPOTENCY_TTL_SECONDS=86400
# 相同问题答案缓存 TTL（BE-16 成本控制，命中率目标 ≥15%）
WK_ANSWER_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 数据源 · 向量库（Milvus 2.4 Standalone，1024 维）
# ------------------------------------------------------------------------------
WK_MILVUS_HOST=milvus
WK_MILVUS_PORT=19530
WK_MILVUS_COLLECTION=wk_knowledge_chunks
WK_MILVUS_USER=
WK_MILVUS_PASSWORD=

# ------------------------------------------------------------------------------
# 数据源 · 稀疏召回（Elasticsearch 8 / BM25）
# ------------------------------------------------------------------------------
WK_ES_URL=http://elasticsearch:9200
WK_ES_INDEX=wk_knowledge_chunks
WK_ES_USER=
WK_ES_PASSWORD=

# ------------------------------------------------------------------------------
# 对象存储 OSS（语音原文件 / 图片 / 导出）
# ------------------------------------------------------------------------------
WK_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
WK_OSS_BUCKET=wankeai-agent
WK_OSS_ACCESS_KEY_ID=
WK_OSS_ACCESS_KEY_SECRET=
# 语音原始文件生命周期 7 天自动删除（合规要求）
WK_VOICE_OBJECT_TTL_DAYS=7

# ------------------------------------------------------------------------------
# RAG 参数（**硬性，不得修改**，契约 2.4.2 / BE-05）
# ------------------------------------------------------------------------------
WK_EMBEDDING_DIM=1024
WK_RAG_TOP_K_VECTOR=20
WK_RAG_TOP_K_BM25=20
WK_RAG_TOP_N_RERANK=5
# 直接答阈值：top_score >= 0.72 → DIRECT_ANSWER
WK_RAG_THRESHOLD_DIRECT=0.72
# 兜底阈值：top_score < 0.55 → NO_EVIDENCE（必须兜底或转人工，不得生成）
WK_RAG_THRESHOLD_FALLBACK=0.55
WK_RAG_RRF_K=60
WK_CHUNK_OVERLAP_RATIO=0.15
# 知识更新后生效延迟上限（分钟）
WK_KNOWLEDGE_EFFECTIVE_DELAY_MINUTES=5
# LLM 上下文只送 Top-3（成本控制）
WK_LLM_CONTEXT_TOP_N=3

# ------------------------------------------------------------------------------
# Embedding（1024 维，国产境内服务）
# ------------------------------------------------------------------------------
# local = 内置确定性哈希向量（离线可跑）；dashscope = text-embedding-v3
WK_EMBEDDING_PROVIDER=local
WK_EMBEDDING_BASE_URL=
WK_EMBEDDING_API_KEY=
WK_EMBEDDING_MODEL=text-embedding-v3

# ------------------------------------------------------------------------------
# Cross-Encoder Rerank（RAG 六步第 5 步）
# ------------------------------------------------------------------------------
WK_RERANK_BASE_URL=
WK_RERANK_API_KEY=
WK_RERANK_MODEL=gte-rerank

# ------------------------------------------------------------------------------
# LLM 网关（BE-16：主 + 备双通道，均须境内）
# ------------------------------------------------------------------------------
# local = 抽取式模板生成器（离线确定性，用于跑通三道闸与端到端链路）
WK_LLM_PROVIDER=local
WK_LLM_BASE_URL=
WK_LLM_API_KEY=
WK_LLM_MODEL=qwen-plus
WK_LLM_FALLBACK_PROVIDER=local
WK_LLM_FALLBACK_BASE_URL=
WK_LLM_FALLBACK_API_KEY=
WK_LLM_FALLBACK_MODEL=glm-4
WK_LLM_TIMEOUT_SECONDS=20.0
# 单条回复 ≤ 120 字
WK_LLM_MAX_OUTPUT_CHARS=120
# **禁止调用境外模型 API**（网络层白名单强制）
WK_LLM_DOMAIN_ALLOWLIST=dashscope.aliyuncs.com,open.bigmodel.cn,localhost,127.0.0.1
WK_LLM_DAILY_BUDGET_ALERT_RATIO=0.8

# ------------------------------------------------------------------------------
# ASR / VLM / OCR（国产境内服务）
# ------------------------------------------------------------------------------
WK_ASR_PROVIDER=local
WK_ASR_BASE_URL=
WK_ASR_API_KEY=
# ASR 置信度 < 0.6 → need_clarify 回问「您是说 XXX 吗」
WK_ASR_LOW_CONFIDENCE=0.6
WK_VOICE_MAX_DURATION_SECONDS=60

WK_VLM_PROVIDER=local
WK_VLM_BASE_URL=
WK_VLM_API_KEY=
WK_VLM_MATCH_THRESHOLD=0.6

WK_OCR_PROVIDER=local
WK_OCR_BASE_URL=
WK_OCR_API_KEY=
# OCR 置信度 < 0.95 → 引导手动输入订单号
WK_OCR_CONFIDENCE_THRESHOLD=0.95

# ------------------------------------------------------------------------------
# 多模态预处理
# ------------------------------------------------------------------------------
WK_IMAGE_MAX_BYTES=10485760
WK_IMAGE_ALLOWED_FORMATS=jpg,jpeg,png,webp
WK_FFMPEG_PATH=ffmpeg
WK_AUDIO_TARGET_SAMPLE_RATE=16000
WK_AUDIO_TARGET_CHANNELS=1

# ------------------------------------------------------------------------------
# 转人工（BE-13 / BE-14 / BE-15）
# ------------------------------------------------------------------------------
# turn_count > 10 强制引导转人工
WK_MAX_TURNS_PER_SESSION=10
# 同一问题连续 2 轮兜底 → 未解决转人工（规则③）
WK_UNRESOLVED_THRESHOLD=2
# 连续 3 轮负面情绪 → 转人工（规则②）
WK_NEGATIVE_EMOTION_STREAK=3
# 单会话订单查询 20 次/小时（BE-08 越权防护）
WK_ORDER_QUERY_HOURLY_LIMIT=20
# 工单接口 5 QPS（全局瓶颈）
WK_TICKET_QPS=5
# 工单本地队列退避序列（秒）
WK_TICKET_RETRY_BACKOFF=1,2,4,8,16
WK_AGENT_ONLINE_REFRESH_SECONDS=300

# ------------------------------------------------------------------------------
# 限流（BE-18，与商家《接口对接说明书》一致）
# ------------------------------------------------------------------------------
WK_QPS_ORDER_QUERY=20
WK_QPS_LOGISTICS_TRACK=20
WK_QPS_INVENTORY_QUERY=50
WK_QPS_PRODUCT_DETAIL=30
WK_QPS_TICKET_CREATE=5
WK_QPS_MESSAGE_SEND=30

# ------------------------------------------------------------------------------
# 幂等 / 重试 / 熔断（BE-18）
# ------------------------------------------------------------------------------
WK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
WK_CIRCUIT_BREAKER_OPEN_SECONDS=30
WK_RETRY_BACKOFF_BASE=0.5
WK_RETRY_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 合规（BE-17）
# ------------------------------------------------------------------------------
WK_API_LOG_RETENTION_MONTHS=6
WK_WRITE_LOG_RETENTION_MONTHS=12
WK_COMPLIANCE_GATE_ENABLED=true

# ------------------------------------------------------------------------------
# 数据目录
# ------------------------------------------------------------------------------
WK_MERCHANT_PACKAGE_DIR=D:/learn/homework/agent/商家材料包

# ------------------------------------------------------------------------------
# 仅 docker-compose 使用（应用不读取）
# ------------------------------------------------------------------------------
# 镜像源前缀（只作用于 docker.io 上的镜像）。
# 国内直连 docker.io 受限时改为 docker.m.daocloud.io（实测可用）。
# 注意 1：若本机开了系统代理，拉镜像会因「非大陆 IP」被镜像站拒绝（403），
#         需要给 Docker 配置 no-proxy 或绕过代理。
# 注意 2：非 docker.io 的仓库不能套这个前缀，见下面的 ETCD_IMAGE / ES_IMAGE。
REGISTRY_MIRROR=docker.io
# 非 docker.io 仓库的基础镜像（按 DaoCloud 前缀替换规则，可直连时改回官方地址）
#   etcd:  quay.io/coreos/etcd:v3.5.14
#   ES:    docker.elastic.co/elasticsearch/elasticsearch:8.13.4
ETCD_IMAGE=quay.m.daocloud.io/coreos/etcd:v3.5.14
ES_IMAGE=elastic.m.daocloud.io/elasticsearch/elasticsearch:8.13.4
# MinIO 官方镜像已从 Docker Hub 下架，用社区同 tag 形态镜像；有自建仓时替换
MINIO_IMAGE=docker.1ms.run/pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# 构建期国内源（留空则用官方源；出海环境保持留空）
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# compose 数据卷根目录
DOCKER_VOLUME_DIRECTORY=./.docker-volumes
# PostgreSQL
POSTGRES_DB=wkagent
POSTGRES_USER=wkagent
POSTGRES_PASSWORD=wkagent
# 宿主机端口映射（避免与本机已有 Redis 6379 冲突）
HOST_REDIS_PORT=6380
HOST_POSTGRES_PORT=5433
HOST_MILVUS_PORT=19531
HOST_ES_PORT=9201
HOST_APP_PORT=8000
